<Window x:Class="Hearth.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hearth — Modpack Launcher" Icon="Assets/Hearth.ico" UseLayoutRounding="True" Width="1280" Height="850" MinWidth="1000" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        Background="#171B1D" Foreground="#F3F5F3" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style x:Key="TerrainOption" TargetType="RadioButton">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Foreground" Value="#F3F5F3"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#61C628"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#93BD79"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border Background="#171B1D">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="0"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#1B2022" BorderBrush="#444B4D" BorderThickness="0,0,1,0">
                    <Grid x:Name="SidebarPanel" Margin="12,12,12,13">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="12,12,0,24"><ContentControl x:Name="BrandIcon" Width="30" Height="32" Margin="0,0,10,0"/><StackPanel><TextBlock Text="Hearth" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Modpack Launcher" FontSize="11" Foreground="#A2ADA7"/></StackPanel></StackPanel>
                            <Button x:Name="LibraryNav" Click="Library_Click" Background="Transparent" BorderThickness="0" Margin="0,0,0,7" Padding="12,11" HorizontalContentAlignment="Stretch" FontSize="15"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel x:Name="PackSidebar" Margin="0,0,0,20"/>
                                <Button x:Name="AddPackNav" Click="AddPack_Click" Background="Transparent" BorderThickness="0" Padding="12,12" Margin="0,0,0,6" HorizontalContentAlignment="Left" FontSize="15"/>
                                <Border Height="1" Background="#343C3D" Margin="12,14,12,12"/>
                                <Button x:Name="PublishNav" Click="Publish_Click" Background="Transparent" BorderThickness="0" Padding="12,12" Margin="0,0,0,6" HorizontalContentAlignment="Left" FontSize="15"/>
                                <Button x:Name="HostsNav" Click="Hosts_Click" Background="Transparent" BorderThickness="0" Padding="12,12" Margin="0,0,0,6" HorizontalContentAlignment="Left" FontSize="15"/>
                            </StackPanel>
                        </ScrollViewer>
                        <Button Grid.Row="2" x:Name="SettingsNav" Click="Settings_Click" Background="Transparent" BorderThickness="0" Padding="12,12" Margin="0,4,0,0" HorizontalContentAlignment="Left" FontSize="15"/>
                    </Grid>
                </Border>
                <Grid x:Name="MainContent" Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border x:Name="PageHeader" BorderBrush="#373F40" BorderThickness="0,0,0,1" Padding="28,23,28,20"><DockPanel><StackPanel x:Name="PageActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"/><TextBlock Visibility="Collapsed" x:Name="ProfileLabel" DockPanel.Dock="Right"/><StackPanel VerticalAlignment="Center"><TextBlock Visibility="Collapsed" x:Name="PageEyebrow"/><TextBlock x:Name="PageTitle" FontSize="27" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/></StackPanel></DockPanel></Border>
                    <ScrollViewer x:Name="PageScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Page" Margin="28,23,28,30"/></ScrollViewer>
                    <Grid x:Name="LibraryView" Grid.RowSpan="2">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" x:Name="Hero" ClipToBounds="True" MinHeight="230" Background="#283C38">
                            <Image x:Name="HeroImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#000F1717" Offset="0.36"/><GradientStop Color="#30101515" Offset="0.65"/><GradientStop Color="#E00E1412" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                            <StackPanel VerticalAlignment="Bottom" Margin="27,0,27,24"><TextBlock x:Name="HeroTitle" Text="Add your first modpack" Foreground="White" FontSize="43" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="HeroSubtitle" Text="Paste an invite from your friend to get started." Foreground="#E2EADF" FontSize="13" Margin="2,9,0,0"/></StackPanel>
                        </Grid>
                        <Border x:Name="PlayPanel" Grid.Row="1" Background="#202628" BorderBrush="#444C4D" BorderThickness="1" CornerRadius="10" Margin="16,16,16,0" Padding="16,11">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="PackStatusDot" Fill="#91A18F" Width="10" Height="10" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock x:Name="PackStatusText" Text="No modpack selected" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="PackStatusHint" Foreground="#AEBBB2" FontSize="12" Margin="26,5,0,0"/></StackPanel>
                                <Button x:Name="PlayButton" Grid.Column="1" Click="Play_Click" Background="#62C629" Foreground="White" BorderThickness="0" Padding="22,11" Margin="0" MinWidth="176" Height="52" FontSize="20" FontWeight="SemiBold" Content="Play"/>
                                <Button x:Name="PackOptionsButton" Grid.Column="2" Content="⋯" Click="PackOptions_Click" Background="Transparent" BorderThickness="0" FontSize="26" Foreground="#CED8CE" Padding="12,1" Width="48" Margin="12,0,0,0" HorizontalAlignment="Right" ToolTip="Pack options" AutomationProperties.Name="Pack options"/>
                            </Grid>
                        </Border>
                        <Border x:Name="TerrainPanel" Grid.Row="2" Background="#202628" BorderBrush="#444C4D" BorderThickness="1" CornerRadius="10" Margin="16,14,16,15" Padding="16,12">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Distant terrain" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <Border Grid.Column="1" BorderBrush="#697372" BorderThickness="1" CornerRadius="7" Padding="2" Background="#292F31"><StackPanel x:Name="TerrainSelector" Orientation="Horizontal"><RadioButton x:Name="TerrainOff" Content="Off" Width="76" GroupName="Terrain" Style="{StaticResource TerrainOption}"/><RadioButton x:Name="TerrainVoxy" Content="Voxy" Width="84" GroupName="Terrain" Style="{StaticResource TerrainOption}"/><RadioButton x:Name="TerrainDh" Content="Distant Horizons" Width="156" GroupName="Terrain" Style="{StaticResource TerrainOption}"/></StackPanel></Border>
                            </Grid>
                        </Border>
                        <Border x:Name="PrismNotice" Grid.Row="3" Background="#293323" BorderBrush="#47533C" BorderThickness="1,0,0,0" Padding="16,10" Margin="16,0,16,15"><DockPanel><Button DockPanel.Dock="Right" Content="Set up Prism" Click="SetupPrism_Click" Background="#3F5830" BorderBrush="#67874B" Padding="13,7" Margin="14,0,0,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Minecraft setup" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Install Prism, then sign in with your own Microsoft account." Foreground="#B6C2B0" FontSize="12" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
                    </Grid>
                </Grid>
            </Grid>
            <Border Grid.Row="2" Background="#1E2426" BorderBrush="#4B5354" BorderThickness="0,1,0,0" CornerRadius="0" Padding="17,7,17,7">
                <DockPanel>
                    <Button x:Name="UpdatesButton" Content="Check for updates" Click="Updates_Click" DockPanel.Dock="Right" Background="Transparent" BorderThickness="0" Padding="12,5" Margin="15,0,0,0" FontSize="13" FontWeight="Normal"/>
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" DockPanel.Dock="Right" Visibility="Collapsed" Padding="12,5" Margin="8,0,0,0"/>
                    <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="85" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="12,0"/>
                    <TextBlock x:Name="VersionLabel" Text="HEARTH" DockPanel.Dock="Left" Foreground="#85928B" FontSize="10" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock x:Name="StatusText" Text="Ready" Foreground="#AFBBB3" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
